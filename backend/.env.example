# Copy this file to backend/.env and fill in your keys.
# The backend loads it automatically on startup -- no exports needed.

DEEPGRAM_API_KEY=your-deepgram-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Required in production; anything long and random.
CLIPPER_SECRET_KEY=change-me-to-something-long-and-random

# Optional: lets Clipper use your browser's YouTube sign-in for
# age-restricted videos. One of: chrome, safari, firefox, edge, brave.
# CLIPPER_COOKIES_BROWSER=chrome

# Optional: how long rendered clips are kept on disk (default 720 = 30 days).
# CLIPPER_RETENTION_HOURS=720

# Accounts that get every paid capability regardless of plan, for testing the
# premium experience without buying it. Comma-separated, empty by default.
# Grants FEATURES only -- credits are still spent at the normal rate.
# Gmail dots are ignored when matching (you.name@gmail.com == youname@gmail.com).
# ADMIN_EMAILS=you@example.com,qa@example.com
